!DOCTYPE html>
<html>
<head>
    <title>Fast Food</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            touch-action: none;
            -ms-touch-action: none;
            background: #0d0f18;
        }

        #game-world {
            position: relative;
            width: 100%;
            height: 100%;
        }

        #game-canvas {
            display: block;
            width: 100%;
            height: 100%;
        }
    </style>
</head>
<body>
    <div id="game-world">
        <canvas id="game-canvas"></canvas>
    </div>

    <script>
        /* Fast Food – Pase de arte cyber-neón. Lienzo lógico 720×1280. */
        async function run(mode) {
            const canvas = document.getElementById('game-canvas');
            const ctx = canvas.getContext('2d');
            const LOGICAL_W = 720;
            const LOGICAL_H = 1280;

            function resize() {
                const dpr = window.devicePixelRatio || 1;
                const cw = canvas.clientWidth;
                const ch = canvas.clientHeight;
                canvas.width = cw * dpr;
                canvas.height = ch * dpr;
                ctx.setTransform((cw * dpr) / LOGICAL_W, 0, 0, (ch * dpr) / LOGICAL_H, 0, 0);
            }
            resize();
            window.addEventListener('resize', resize);

            const cfg = window.gameConfig;
            cfg.art = cfg.art || {};
            const art = cfg.art;
            const defaults = {
                backgroundColor: '#0d0f18', cyan: '#00f3ff', magenta: '#ff007f',
                green: '#39ff14', yellow: '#ffe600', glowIntensity: 1, particleCount: 42
            };
            const gameplayDefaults = {
                livesInitial: 5, rewardProbability: 0.62,
                fallingSpeedStart: 280, fallingSpeedMax: 700, speedPerPoint: 12,
                spawnIntervalStart: 0.95, spawnIntervalMin: 0.38, intervalDecreasePerPoint: 0.015,
                maxObstacleStreak: 3
            };
            for (const [key, value] of Object.entries(gameplayDefaults)) {
                if (cfg[key] == null) cfg[key] = value;
            }
            if (cfg.soundVolume == null) cfg.soundVolume = 0.55;
            if (cfg.visualEffectsIntensity == null) cfg.visualEffectsIntensity = 1;
            const setting = (key) => {
                const n = Number(cfg[key]);
                return Number.isFinite(n) ? n : gameplayDefaults[key];
            };
            function artValue(key) { return art[key] == null ? defaults[key] : art[key]; }

            lib.showGameParameters({
                name: 'Fast Food – Arte Cyber-neón',
                params: {
                    'Player Speed': { key: 'playerSpeed', type: 'slider', min: 240, max: 900, step: 10 },
                    'Color de fondo': { key: 'art.backgroundColor', type: 'color' },
                    'Cian neón': { key: 'art.cyan', type: 'color' },
                    'Magenta neón': { key: 'art.magenta', type: 'color' },
                    'Verde neón': { key: 'art.green', type: 'color' },
                    'Amarillo neón': { key: 'art.yellow', type: 'color' },
                    'Intensidad del brillo': { key: 'art.glowIntensity', type: 'slider', min: 0, max: 2, step: 0.1 },
                    'Cantidad de partículas': { key: 'art.particleCount', type: 'slider', min: 0, max: 100, step: 1 },
                    'Vidas iniciales': { key: 'livesInitial', type: 'slider', min: 1, max: 10, step: 1 },
                    'Probabilidad de recompensa': { key: 'rewardProbability', type: 'slider', min: 0, max: 1, step: 0.01 },
                    'Velocidad inicial de caída': { key: 'fallingSpeedStart', type: 'slider', min: 100, max: 600, step: 10 },
                    'Velocidad máxima de caída': { key: 'fallingSpeedMax', type: 'slider', min: 300, max: 1200, step: 10 },
                    'Aumento de velocidad por punto': { key: 'speedPerPoint', type: 'slider', min: 0, max: 40, step: 1 },
                    'Intervalo inicial (segundos)': { key: 'spawnIntervalStart', type: 'slider', min: 0.5, max: 2.5, step: 0.05 },
                    'Intervalo mínimo (segundos)': { key: 'spawnIntervalMin', type: 'slider', min: 0.15, max: 1, step: 0.01 },
                    'Reducción del intervalo por punto': { key: 'intervalDecreasePerPoint', type: 'slider', min: 0, max: 0.08, step: 0.001 },
                    'Racha máxima de obstáculos': { key: 'maxObstacleStreak', type: 'slider', min: 1, max: 8, step: 1 },
                    'Volumen de sonido': { key: 'soundVolume', type: 'slider', min: 0, max: 1, step: 0.05 },
                    'Intensidad de efectos visuales': { key: 'visualEffectsIntensity', type: 'slider', min: 0, max: 2, step: 0.1 }
                }
            });

            const PLATE_W = 210;
            const PLATE_H = 180;
            let playerX = LOGICAL_W / 2;
            const playerY = LOGICAL_H - 135;
            function getSpeed() { return cfg.playerSpeed || 540; }

            // Load the illustrated catcher once; the vector fallback is used only while unavailable.
            let plateImage = null;
            const plateAsset = lib.getAsset('plate_catcher');
            if (plateAsset && plateAsset.url) {
                plateImage = new Image();
                plateImage.src = plateAsset.url;
            }
            // Cache all six falling-object illustrations once during initialization.
            const objectAssetIds = ['food_burger','food_pizza','food_ice_cream','obstacle_trash_can','obstacle_hot_coal','obstacle_flame'];
            const objectImages = {};
            for (const id of objectAssetIds) {
                const asset = lib.getAsset(id);
                if (asset && asset.url) {
                    const image = new Image();
                    image.src = asset.url;
                    objectImages[id] = image;
                }
            }

            const keys = {};
            window.addEventListener('keydown', e => {
                if (mode === 'play' && (e.key === 'Enter' || e.key === ' ')) {
                    e.preventDefault();
                    if (!hasStarted && !gameOver) startGame();
                    else if (gameOver) restartGame();
                    return;
                }
                if (mode === 'play' && hasStarted && !gameOver && ['ArrowLeft','ArrowRight','a','d','A','D'].includes(e.key)) {
                    e.preventDefault(); keys[e.key] = true;
                }
            });
            window.addEventListener('keyup', e => { keys[e.key] = false; });
            window.addEventListener('blur', () => { for (const k in keys) keys[k] = false; });

            let dragging = false;
            let dragPointerId = null;
            let dragOffsetX = 0;
            function pointerToLogical(clientX, clientY) {
                const rect = canvas.getBoundingClientRect();
                return { x: (clientX - rect.left) / rect.width * LOGICAL_W, y: (clientY - rect.top) / rect.height * LOGICAL_H };
            }
            canvas.addEventListener('pointerdown', e => {
                if (mode === 'edit' || dragging) return;
                const p = pointerToLogical(e.clientX, e.clientY);
                if (!hasStarted && !gameOver) {
                    if (p.x >= startButton.x && p.x <= startButton.x + startButton.w && p.y >= startButton.y && p.y <= startButton.y + startButton.h) startGame();
                    return;
                }
                if (gameOver) {
                    if (p.x >= retryButton.x && p.x <= retryButton.x + retryButton.w && p.y >= retryButton.y && p.y <= retryButton.y + retryButton.h) restartGame();
                    return;
                }
                dragging = true; dragPointerId = e.pointerId; dragOffsetX = playerX - p.x;
                canvas.setPointerCapture(e.pointerId);
            });
            canvas.addEventListener('pointermove', e => {
                if (!dragging || e.pointerId !== dragPointerId) return;
                playerX = pointerToLogical(e.clientX, e.clientY).x + dragOffsetX;
                clampPlayer();
            });
            function releaseDrag(e) {
                if (e.pointerId === dragPointerId) { dragging = false; dragPointerId = null; }
            }
            canvas.addEventListener('pointerup', releaseDrag);
            canvas.addEventListener('pointercancel', releaseDrag);

            function clampPlayer() {
                const half = PLATE_W / 2;
                playerX = Math.max(half, Math.min(LOGICAL_W - half, playerX));
            }

            // A bounded particle pool is resized only when the editable count changes.
            let particles = [];
            let particleCountCached = -1;
            function syncParticles() {
                const target = Math.max(0, Math.min(100, Math.round(Number(artValue('particleCount')) || 0)));
                if (target === particleCountCached) return;
                particles = particles.slice(0, target);
                while (particles.length < target) {
                    particles.push({ x: Math.random() * LOGICAL_W, y: Math.random() * LOGICAL_H,
                        radius: 1 + Math.random() * 2.2, speed: 10 + Math.random() * 27,
                        phase: Math.random() * Math.PI * 2, tint: Math.random() < 0.72 ? 'cyan' : 'magenta' });
                }
                particleCountCached = target;
            }

            function drawBackground(dt, time) {
                const intensity = Math.max(0, Number(artValue('glowIntensity')) || 0);
                const cyan = artValue('cyan');
                const magenta = artValue('magenta');
                ctx.fillStyle = artValue('backgroundColor');
                ctx.fillRect(0, 0, LOGICAL_W, LOGICAL_H);

                // Dim pools of colored light create depth without competing with the play field.
                const glow = ctx.createRadialGradient(115, 240, 8, 115, 240, 480);
                glow.addColorStop(0, `rgba(0,243,255,${0.065 * Math.min(intensity, 2)})`);
                glow.addColorStop(1, 'rgba(0,243,255,0)');
                ctx.fillStyle = glow; ctx.fillRect(0, 0, LOGICAL_W, LOGICAL_H);
                const pinkGlow = ctx.createRadialGradient(610, 820, 10, 610, 820, 430);
                pinkGlow.addColorStop(0, `rgba(255,0,127,${0.045 * Math.min(intensity, 2)})`);
                pinkGlow.addColorStop(1, 'rgba(255,0,127,0)');
                ctx.fillStyle = pinkGlow; ctx.fillRect(0, 0, LOGICAL_W, LOGICAL_H);

                ctx.save();
                ctx.lineWidth = 1;
                ctx.strokeStyle = 'rgba(0,243,255,0.055)';
                for (let x = 0; x <= LOGICAL_W; x += 60) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, LOGICAL_H); ctx.stroke(); }
                for (let y = 0; y <= LOGICAL_H; y += 60) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(LOGICAL_W, y); ctx.stroke(); }
                // Quietly emphasized grid intersections at the outer edges.
                ctx.fillStyle = 'rgba(0,243,255,0.12)';
                for (let x = 0; x <= LOGICAL_W; x += 120) for (let y = 0; y <= LOGICAL_H; y += 120) {
                    ctx.beginPath(); ctx.arc(x, y, 1.5, 0, Math.PI * 2); ctx.fill();
                }
                ctx.restore();

                syncParticles();
                for (const p of particles) {
                    p.y += p.speed * dt;
                    if (p.y > LOGICAL_H + 4) { p.y = -4; p.x = Math.random() * LOGICAL_W; }
                    const pulse = 0.45 + 0.35 * Math.sin(time * 0.0014 + p.phase);
                    const color = p.tint === 'cyan' ? cyan : magenta;
                    ctx.save();
                    ctx.globalAlpha = pulse;
                    ctx.fillStyle = color;
                    ctx.shadowColor = color;
                    ctx.shadowBlur = 5 * intensity;
                    ctx.beginPath(); ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2); ctx.fill();
                    ctx.restore();
                }
            }

            function drawFallbackPlate(x, y, cyan, magenta, intensity) {
                ctx.save();
                ctx.shadowColor = cyan; ctx.shadowBlur = 18 * intensity;
                ctx.fillStyle = '#f7f8fb'; ctx.beginPath(); ctx.ellipse(x, y, 104, 78, 0, 0, Math.PI * 2); ctx.fill();
                ctx.shadowBlur = 0; ctx.strokeStyle = cyan; ctx.lineWidth = 3; ctx.stroke();
                ctx.fillStyle = '#e7edf2'; ctx.beginPath(); ctx.ellipse(x, y, 87, 62, 0, 0, Math.PI * 2); ctx.fill();
                ctx.strokeStyle = 'rgba(255,0,127,0.65)'; ctx.lineWidth = 2; ctx.beginPath(); ctx.ellipse(x, y, 78, 54, 0, 0, Math.PI * 2); ctx.stroke();
                // Tiny food illustrations as a graceful fallback during image loading.
                ctx.fillStyle = '#9b4c22'; ctx.beginPath(); ctx.ellipse(x - 38, y - 13, 27, 19, 0, 0, Math.PI * 2); ctx.fill();
                ctx.fillStyle = '#f1bc56'; ctx.beginPath(); ctx.ellipse(x - 38, y - 19, 26, 11, 0, Math.PI, Math.PI * 2); ctx.fill();
                ctx.fillStyle = '#d84a47'; ctx.beginPath(); ctx.moveTo(x + 4, y - 24); ctx.lineTo(x + 51, y - 7); ctx.lineTo(x + 12, y + 4); ctx.closePath(); ctx.fill();
                ctx.strokeStyle = '#f2c65d'; ctx.lineWidth = 5; ctx.stroke();
                ctx.fillStyle = '#78dcff'; ctx.beginPath(); ctx.arc(x + 23, y + 25, 14, 0, Math.PI * 2); ctx.fill();
                ctx.fillStyle = '#d59a62'; ctx.beginPath(); ctx.moveTo(x + 11, y + 35); ctx.lineTo(x + 35, y + 35); ctx.lineTo(x + 23, y + 53); ctx.closePath(); ctx.fill();
                ctx.restore();
            }

            function drawPlate(x, y) {
                const intensity = Math.max(0, Number(artValue('glowIntensity')) || 0);
                const cyan = artValue('cyan');
                if (plateImage && plateImage.complete && plateImage.naturalWidth > 0) {
                    const aspect = plateImage.naturalWidth / plateImage.naturalHeight;
                    let w = PLATE_W, h = w / aspect;
                    if (h > PLATE_H) { h = PLATE_H; w = h * aspect; }
                    ctx.save(); ctx.shadowColor = cyan; ctx.shadowBlur = 20 * intensity;
                    ctx.drawImage(plateImage, x - w / 2, y - h / 2, w, h); ctx.restore();
                } else {
                    drawFallbackPlate(x, y, cyan, artValue('magenta'), intensity);
                }
            }

            function drawHeart(x, y, size, color, intensity) {
                ctx.save();
                ctx.translate(x, y); ctx.scale(size / 30, size / 30);
                ctx.shadowColor = color; ctx.shadowBlur = 12 * intensity;
                ctx.fillStyle = '#ff335d'; ctx.strokeStyle = '#ff8da0'; ctx.lineWidth = 1.6;
                ctx.beginPath();
                ctx.moveTo(0, 25); ctx.bezierCurveTo(-4, 21, -20, 11, -20, -1);
                ctx.bezierCurveTo(-20, -13, -5, -17, 0, -7);
                ctx.bezierCurveTo(5, -17, 20, -13, 20, -1);
                ctx.bezierCurveTo(20, 11, 4, 21, 0, 25); ctx.closePath();
                ctx.fill(); ctx.stroke(); ctx.restore();
            }

            let score = 0;
            let initialLives = Math.max(1, Math.min(10, Math.round(setting('livesInitial'))));
            let lives = initialLives;
            let hasStarted = false;
            let gameOver = false;
            let fallingObjects = [];
            let spawnTimer = 0.55;
            let obstacleStreak = 0;
            const startButton = { x: 110, y: 700, w: 500, h: 124 };
            const retryButton = { x: 150, y: 730, w: 420, h: 112 };
            let audioContext = null;
            let impactParticles = [];
            let screenShake = 0;
            let visualFlash = 0;
            let flashColor = '#ff007f';

            function effectIntensity() {
                return Math.max(0, Math.min(2, Number(cfg.visualEffectsIntensity) || 0));
            }
            function ensureAudio() {
                try {
                    if (!audioContext) {
                        const AudioCtor = window.AudioContext || window.webkitAudioContext;
                        if (AudioCtor) audioContext = new AudioCtor();
                    }
                    if (audioContext && audioContext.state === 'suspended') audioContext.resume().catch(() => {});
                } catch (_) { /* Audio is optional; keep gameplay available if unavailable. */ }
                return audioContext;
            }
            function playTone(frequency, duration, type, peak, startAt, endFrequency) {
                const ac = ensureAudio();
                if (!ac) return;
                const volume = Math.max(0, Math.min(1, Number(cfg.soundVolume) || 0));
                if (volume <= 0) return;
                try {
                    const osc = ac.createOscillator();
                    const gain = ac.createGain();
                    const t = ac.currentTime + (startAt || 0);
                    osc.type = type || 'sine';
                    osc.frequency.setValueAtTime(frequency, t);
                    if (endFrequency) osc.frequency.exponentialRampToValueAtTime(Math.max(1, endFrequency), t + duration);
                    gain.gain.setValueAtTime(0.0001, t);
                    gain.gain.exponentialRampToValueAtTime(Math.max(0.0002, peak * volume), t + 0.012);
                    gain.gain.exponentialRampToValueAtTime(0.0001, t + duration);
                    osc.connect(gain); gain.connect(ac.destination);
                    osc.start(t); osc.stop(t + duration + 0.025);
                } catch (_) { /* Ignore browser audio scheduling failures. */ }
            }
            function playCollectSound() {
                playTone(740, 0.11, 'sine', 0.12, 0, 980);
                playTone(1080, 0.12, 'sine', 0.09, 0.085, 1280);
            }
            function playImpactSound() {
                playTone(145, 0.24, 'sawtooth', 0.16, 0, 68);
            }
            function playGameOverSound() {
                playTone(440, 0.22, 'triangle', 0.13, 0, 350);
                playTone(330, 0.24, 'triangle', 0.13, 0.19, 255);
                playTone(247, 0.29, 'triangle', 0.14, 0.39, 185);
                playTone(165, 0.42, 'triangle', 0.15, 0.64, 90);
            }
            function burstImpact(x, y, reward) {
                const intensity = effectIntensity();
                const color = reward ? artValue('yellow') : artValue('magenta');
                const count = Math.round(12 * intensity);
                for (let i = 0; i < count; i++) {
                    const angle = Math.random() * Math.PI * 2;
                    const speed = 70 + Math.random() * 190;
                    impactParticles.push({ x, y, vx: Math.cos(angle) * speed, vy: Math.sin(angle) * speed,
                        life: 0.28 + Math.random() * 0.3, maxLife: 0.58, radius: 2 + Math.random() * 4, color });
                }
                if (!reward && intensity > 0) screenShake = Math.max(screenShake, 5 * intensity);
                visualFlash = Math.max(visualFlash, reward ? 0.11 * intensity : 0.17 * intensity);
                flashColor = color;
            }
            function updateEffects(dt) {
                for (let i = impactParticles.length - 1; i >= 0; i--) {
                    const p = impactParticles[i];
                    p.x += p.vx * dt; p.y += p.vy * dt;
                    p.vx *= Math.pow(0.08, dt); p.vy *= Math.pow(0.08, dt);
                    p.life -= dt;
                    if (p.life <= 0) impactParticles.splice(i, 1);
                }
                screenShake = Math.max(0, screenShake - 30 * dt);
                visualFlash = Math.max(0, visualFlash - dt);
            }
            function drawImpactParticles() {
                const intensity = effectIntensity();
                if (intensity <= 0) return;
                ctx.save();
                for (const p of impactParticles) {
                    ctx.globalAlpha = Math.max(0, p.life / p.maxLife);
                    ctx.fillStyle = p.color; ctx.shadowColor = p.color; ctx.shadowBlur = 10 * intensity;
                    ctx.beginPath(); ctx.arc(p.x, p.y, p.radius * Math.min(intensity, 1.5), 0, Math.PI * 2); ctx.fill();
                }
                ctx.restore();
            }
            function insideButton(p, button) {
                return p.x >= button.x && p.x <= button.x + button.w && p.y >= button.y && p.y <= button.y + button.h;
            }
            function startGame() {
                if (hasStarted || gameOver) return;
                ensureAudio();
                restartGame();
            }

            function restartGame() {
                score = 0;
                initialLives = Math.max(1, Math.min(10, Math.round(setting('livesInitial'))));
                lives = initialLives;
                fallingObjects = [];
                spawnTimer = 0.55;
                obstacleStreak = 0;
                gameOver = false;
                hasStarted = true;
                impactParticles = [];
                screenShake = 0;
                visualFlash = 0;
                ensureAudio();
                playerX = LOGICAL_W / 2;
                clampPlayer();
            }

            function currentFallSpeed() {
                return Math.min(setting('fallingSpeedMax'), setting('fallingSpeedStart') + score * setting('speedPerPoint'));
            }
            function currentSpawnInterval() {
                return Math.max(setting('spawnIntervalMin'), setting('spawnIntervalStart') - score * setting('intervalDecreasePerPoint'));
            }
            function spawnObject() {
                const maxStreak = Math.max(1, Math.round(setting('maxObstacleStreak')));
                const rewardChance = Math.max(0, Math.min(1, setting('rewardProbability')));
                const reward = obstacleStreak >= maxStreak || Math.random() < rewardChance;
                let type;
                if (reward) {
                    const kinds = ['burger','pizza','icecream'];
                    type = kinds[Math.floor(Math.random() * kinds.length)];
                    obstacleStreak = 0;
                } else {
                    const kinds = ['trash','coal','flame'];
                    type = kinds[Math.floor(Math.random() * kinds.length)];
                    obstacleStreak++;
                }
                const assetByType = {
                    burger:'food_burger', pizza:'food_pizza', icecream:'food_ice_cream',
                    trash:'obstacle_trash_can', coal:'obstacle_hot_coal', flame:'obstacle_flame'
                };
                const size = type === 'trash' ? 78 : 72;
                fallingObjects.push({ type, assetId: assetByType[type], x: 52 + Math.random() * (LOGICAL_W - 104),
                    y: -size, size, speed: currentFallSpeed() * (0.84 + Math.random() * 0.32), rotation: (Math.random() - 0.5) * 0.2 });
            }

            function drawHUD() {
                const intensity = Math.max(0, Number(artValue('glowIntensity')) || 0);
                ctx.save();
                ctx.font = '700 38px Arial, sans-serif'; ctx.textBaseline = 'top';
                ctx.shadowColor = artValue('cyan'); ctx.shadowBlur = 12 * intensity;
                ctx.fillStyle = artValue('cyan'); ctx.fillText(`PUNTOS  ${score}`, 38, 36);
                ctx.restore();
                ctx.save();
                ctx.font = '600 17px Arial, sans-serif'; ctx.textAlign = 'right'; ctx.textBaseline = 'top';
                ctx.fillStyle = 'rgba(225,245,255,0.72)'; ctx.fillText('VIDAS', LOGICAL_W - 38, 35);
                ctx.restore();
                for (let i = 0; i < initialLives; i++) {
                    if (i < lives) drawHeart(LOGICAL_W - 45 - i * 34, 85, 25, artValue('magenta'), intensity);
                    else {
                        ctx.save(); ctx.globalAlpha = 0.2; drawHeart(LOGICAL_W - 45 - i * 34, 85, 25, artValue('magenta'), 0); ctx.restore();
                    }
                }
                ctx.save(); ctx.strokeStyle = 'rgba(0,243,255,0.22)'; ctx.lineWidth = 1;
                ctx.beginPath(); ctx.moveTo(36, 126); ctx.lineTo(LOGICAL_W - 36, 126); ctx.stroke(); ctx.restore();
            }

            function drawFallingObject(object) {
                const image = objectImages[object.assetId];
                ctx.save();
                ctx.translate(object.x, object.y);
                ctx.rotate(object.rotation);
                if (image && image.complete && image.naturalWidth > 0) {
                    const aspect = image.naturalWidth / image.naturalHeight;
                    let w = object.size, h = object.size;
                    if (aspect > 1) h = w / aspect; else w = h * aspect;
                    const tint = object.type === 'burger' || object.type === 'pizza' || object.type === 'icecream' ? artValue('yellow') : artValue('magenta');
                    ctx.shadowColor = tint; ctx.shadowBlur = 13 * Math.max(0, Number(artValue('glowIntensity')) || 0);
                    ctx.drawImage(image, -w / 2, -h / 2, w, h);
                } else {
                    const glyph = { burger:'🍔', pizza:'🍕', icecream:'🍦', trash:'🗑️', coal:'🔥', flame:'🔥' }[object.type];
                    ctx.font = '58px serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText(glyph, 0, 0);
                }
                ctx.restore();
            }

            function drawActionButton(button, label, time, color) {
                const pulse = 0.87 + 0.13 * Math.sin(time / 230);
                ctx.save();
                ctx.globalAlpha = pulse;
                ctx.shadowColor = color; ctx.shadowBlur = 28 * Math.max(0.4, effectIntensity());
                ctx.fillStyle = 'rgba(0,243,255,0.13)'; ctx.strokeStyle = color; ctx.lineWidth = 4;
                ctx.beginPath(); ctx.roundRect(button.x, button.y, button.w, button.h, 24); ctx.fill(); ctx.stroke();
                ctx.shadowBlur = 0; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
                ctx.fillStyle = '#ffffff'; ctx.font = '900 42px Arial, sans-serif';
                ctx.fillText(label, button.x + button.w / 2, button.y + button.h / 2);
                ctx.restore();
            }

            function drawStartMenu(time) {
                ctx.save();
                ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
                ctx.shadowColor = artValue('cyan'); ctx.shadowBlur = 34 * Math.max(0.4, effectIntensity());
                ctx.fillStyle = '#ffffff'; ctx.font = '900 86px Arial, sans-serif';
                ctx.fillText('FAST FOOD', LOGICAL_W / 2, 350);
                ctx.shadowBlur = 0; ctx.fillStyle = artValue('magenta');
                ctx.font = '700 25px Arial, sans-serif';
                ctx.fillText('ATRAPA LA COMIDA · ESQUIVA LOS PELIGROS', LOGICAL_W / 2, 422);
                ctx.fillStyle = 'rgba(228,245,255,0.78)'; ctx.font = '500 23px Arial, sans-serif';
                ctx.fillText('Muévete con ← → / A D o arrastra el plato', LOGICAL_W / 2, 620);
                ctx.restore();
                drawPlate(LOGICAL_W / 2, 530);
                drawActionButton(startButton, 'COMENZAR', time, artValue('cyan'));
                ctx.save(); ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
                ctx.fillStyle = 'rgba(210,230,245,0.58)'; ctx.font = '500 19px Arial, sans-serif';
                ctx.fillText('Pulsa COMENZAR o Enter para jugar', LOGICAL_W / 2, 870);
                ctx.restore();
            }

            function drawGameOver(time) {
                ctx.save();
                ctx.fillStyle = 'rgba(5,8,18,0.86)'; ctx.fillRect(0, 0, LOGICAL_W, LOGICAL_H);
                ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
                ctx.strokeStyle = 'rgba(0,243,255,0.38)'; ctx.lineWidth = 2;
                ctx.shadowColor = artValue('cyan'); ctx.shadowBlur = 22;
                ctx.beginPath(); ctx.roundRect(48, 390, LOGICAL_W - 96, 590, 34); ctx.stroke();
                ctx.shadowColor = artValue('magenta'); ctx.shadowBlur = 28;
                ctx.fillStyle = '#fff'; ctx.font = '900 66px Arial, sans-serif'; ctx.fillText('GAME OVER', LOGICAL_W / 2, 510);
                ctx.shadowColor = artValue('cyan'); ctx.shadowBlur = 18;
                ctx.fillStyle = artValue('cyan'); ctx.font = '700 27px Arial, sans-serif'; ctx.fillText('PUNTUACIÓN FINAL', LOGICAL_W / 2, 620);
                ctx.fillStyle = '#ffffff'; ctx.font = '900 76px Arial, sans-serif'; ctx.fillText(String(score), LOGICAL_W / 2, 710);
                ctx.restore();
                drawActionButton(retryButton, 'REINTENTAR', time, artValue('cyan'));
                ctx.save(); ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
                ctx.fillStyle = 'rgba(210,230,245,0.66)'; ctx.font = '500 20px Arial, sans-serif';
                ctx.fillText('Toca el botón o pulsa Enter', LOGICAL_W / 2, 890);
                ctx.restore();
            }

            let lastTime = 0;
            function gameLoop(timestamp) {
                const dt = Math.min((timestamp - (lastTime || timestamp)) / 1000, 0.11);
                lastTime = timestamp;
                updateEffects(dt);
                if (mode === 'play' && hasStarted && !gameOver) {
                    const speed = getSpeed();
                    const left = keys['ArrowLeft'] || keys['a'] || keys['A'];
                    const right = keys['ArrowRight'] || keys['d'] || keys['D'];
                    if (left) playerX -= speed * dt;
                    if (right) playerX += speed * dt;
                    clampPlayer();
                    spawnTimer -= dt;
                    if (spawnTimer <= 0) { spawnObject(); spawnTimer += currentSpawnInterval(); }
                    const playerBox = { left: playerX - 78, right: playerX + 78, top: playerY - 45, bottom: playerY + 48 };
                    for (let i = fallingObjects.length - 1; i >= 0; i--) {
                        const obj = fallingObjects[i];
                        obj.y += obj.speed * dt;
                        const half = obj.size * 0.34;
                        const hit = obj.x + half >= playerBox.left && obj.x - half <= playerBox.right && obj.y + half >= playerBox.top && obj.y - half <= playerBox.bottom;
                        if (hit) {
                            fallingObjects.splice(i, 1);
                            if (obj.type === 'burger' || obj.type === 'pizza' || obj.type === 'icecream') {
                                score++;
                                burstImpact(obj.x, obj.y, true);
                                playCollectSound();
                            } else {
                                lives = Math.max(0, lives - 1);
                                burstImpact(obj.x, obj.y, false);
                                playImpactSound();
                                if (lives === 0) {
                                    gameOver = true; fallingObjects.length = 0;
                                    playGameOverSound();
                                    break;
                                }
                            }
                        } else if (obj.y - obj.size / 2 > LOGICAL_H) fallingObjects.splice(i, 1);
                    }
                }
                drawBackground(dt, timestamp);
                const shake = mode === 'play' ? screenShake : 0;
                ctx.save();
                if (shake > 0) ctx.translate((Math.random() - 0.5) * shake, (Math.random() - 0.5) * shake);
                drawHUD();
                for (const object of fallingObjects) drawFallingObject(object);
                drawImpactParticles();
                if (mode !== 'play' || hasStarted) drawPlate(playerX, playerY);
                ctx.restore();
                if (mode === 'play' && !hasStarted) drawStartMenu(timestamp);
                if (mode === 'play' && gameOver) drawGameOver(timestamp);
                if (mode === 'play' && visualFlash > 0 && hasStarted) {
                    ctx.save(); ctx.globalAlpha = Math.min(0.22, visualFlash * 0.7);
                    ctx.fillStyle = flashColor; ctx.fillRect(0, 126, LOGICAL_W, LOGICAL_H - 126); ctx.restore();
                }
                requestAnimationFrame(gameLoop);
            }
            requestAnimationFrame(gameLoop);
        }
    </script>
</body>
